# Обязательно для работы (веб-чат и Telegram): ключ OpenAI.
OPENAI_API_KEY=

# Модель Chat Completions; по умолчанию используется gpt-4o-mini, если строку не задать.
OPENAI_MODEL=gpt-4o-mini

# Необязательно: адрес HTTP-прокси для вызовов OpenAI Chat Completions API, если у
# сервера нет прямого доступа к api.openai.com. Пусто — ходим напрямую, как раньше.
#
# Контракт прокси (passthrough-режим): Consultant шлёт POST с JSON-телом {"token":...,
# "model":..., "messages":[...], "max_completion_tokens":..., "store":false} и заголовком
# X-Proxy-Secret; прокси должен переслать это на https://api.openai.com/v1/chat/completions с
# Authorization: Bearer {token} и вернуть ответ OpenAI без изменений (без обёртки
# success/text). Отличается от старого режима прокси с одиночным полем "prompt" наличием
# поля "messages".
OAI_PROXY_URL=

# Обязателен вместе с OAI_PROXY_URL — значение должно совпадать с proxy_secret/
# OAI_PROXY_SECRET, настроенным на самом прокси-сервере.
OAI_PROXY_SECRET=

# Только для Telegram-адаптера (bot.php) — для веб-чата на help.mojno.cc не требуется,
# можно оставить пустым, если Telegram не используется.
TELEGRAM_BOT_TOKEN=

# Необязательно: адрес HTTP-прокси для вызовов Telegram Bot API (bot.php), если у сервера нет
# прямого доступа к api.telegram.org. Пусто — ходим напрямую, как раньше.
#
# Контракт прокси: bot.php шлёт POST с JSON-телом {"token":..., "method":"getMe"|"getUpdates"|
# "sendMessage", ...остальные поля запроса к Bot API}, прокси должен переслать это на
# https://api.telegram.org/bot{token}/{method} и вернуть ответ Telegram без изменений. Важно:
# getUpdates идёт с 'timeout'=>20 в payload (long-polling) — таймаут HTTP-запроса на
# стороне прокси должен быть больше 20 секунд, иначе прокси будет обрывать
# ожидание раньше, чем Telegram успеет ответить.
TELEGRAM_API_PROXY_URL=

# Точный origin, с которого загружается страница чата (без пути и завершающего слэша) —
# СВОЙ домен, на котором развёрнут этот проект (например https://help.mojno.cc), а НЕ домен
# страницы/личного кабинета, где чат встроен через iframe. chat.php сверяет с ним заголовок
# Origin входящих POST-запросов; см. README, раздел «Чат на сайте».
WEB_ORIGIN=https://help.mojno.cc

# 1 — ставить Secure на сессионную cookie (обязательно при HTTPS, а прод всегда должен быть
# на HTTPS). 0 — только для локальной разработки по http://.
SESSION_SECURE=1

# Ниже необязательные настройки — при отсутствии в .env используются значения по умолчанию,
# указанные вторым аргументом.
MAX_HISTORY_MESSAGES=20
MAX_MESSAGE_CHARS=3000
HISTORY_TTL_DAYS=30
RATE_LIMIT_PER_MINUTE=8
WEB_IP_LIMIT_PER_MINUTE=20
WEB_GLOBAL_LIMIT_PER_MINUTE=60
