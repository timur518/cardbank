# Адрес Laravel-бэкенда (без /api и без завершающего слэша) — используется и для
# GET {VITE_API_BASE_URL}/sanctum/csrf-cookie, и как базовый URL для {VITE_API_BASE_URL}/api/v1/...
#
# ВАЖНО: хост здесь должен совпадать с хостом фронтенда (localhost), а не быть
# его IP-эквивалентом (127.0.0.1) — иначе браузер считает их разными сайтами и
# по правилу SameSite=Lax не отправляет сессионную/CSRF-куку Sanctum в кросс-origin
# запросах с фронтенда на бэкенд (curl этого не проверяет, поэтому вручную через
# curl всё выглядит рабочим, а в браузере — нет). Порт — тот, на котором реально
# слушает `php artisan serve` (по умолчанию 8000).
VITE_API_BASE_URL=http://localhost:8000

# Адрес встраиваемой страницы ИИ-консультанта — отдельное PHP-приложение public/mojno-help, развёрнуто
# на своём отдельном домене help.mojno.cc (document root строго на public/mojno-help/public,
# см. README этого приложения). ЛК сам добавит ?embed=1 к этому адресу. Если переменная
# не задана, плавающая кнопка чата в ЛК (ChatWidget) вообще не показывается.
#
# Сам help.mojno.cc — отдельный домен от ЛК (mne.mojno.cc), поэтому это кросс-доменное встраивание iframe:
# 1) на самом help.mojno.cc не должно быть заголовка X-Frame-Options: DENY/SAMEORIGIN или CSP
#    frame-ancestors без https://mne.mojno.cc — иначе браузер запретит встраивание (ни chat.php,
#    ни простой PHP-встроенный сервер таких заголовков не ставят, но их может добавить
#    reverse proxy/WAF/панель хостинга по умолчанию);
# 2) WEB_ORIGIN в .env самого mojno-help должен быть равен https://help.mojno.cc (свой же домен,
#    а НЕ https://mne.mojno.cc) — fetch на chat.php изнутри iframe всегда идёт как запрос со своего
#    же домена (help.mojno.cc), независимо от того, в каком iframe он встроен, поэтому CORS не нужен.
VITE_CHAT_WIDGET_URL=https://help.mojno.cc
