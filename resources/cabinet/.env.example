# Адрес Laravel-бэкенда (без /api и без завершающего слэша) — используется и для
# GET {VITE_API_BASE_URL}/sanctum/csrf-cookie, и как базовый URL для {VITE_API_BASE_URL}/api/v1/...
#
# ВАЖНО: хост здесь должен совпадать с хостом фронтенда (localhost), а не быть
# его IP-эквивалентом (127.0.0.1) — иначе браузер считает их разными сайтами и
# по правилу SameSite=Lax не отправляет сессионную/CSRF-куку Sanctum в кросс-origin
# запросах с фронтенда на бэкенд (curl этого не проверяет, поэтому вручную через
# curl всё выглядит рабочим, а в браузере — нет). Порт — тот, на котором реально
# слушает `php artisan serve` (по умолчанию 8000).
VITE_API_BASE_URL=http://localhost:8000

# Адрес встраиваемой страницы ИИ-консультанта (отдельное PHP-приложение public/mojno-help,
# см. его README) — без query-параметров и завершающего слэша, ЛК сам добавит ?embed=1.
# Если переменная не задана, плавающая кнопка чата в ЛК (ChatWidget) вообще не показывается.
#
# Консультант ходит на себя же (fetch на chat.php с того же домена, где размещён public/mojno-help)
# из iframe, поэтому кросс-доменное встраивание в ЛК работает без CORS — на сервере
# консультанта достаточно проверить, что ответы не запрещают встраивание в iframe
# (не должно быть заголовка X-Frame-Options: DENY или CSP frame-ancestors без домена ЛК).
VITE_CHAT_WIDGET_URL=https://mojno.cc/consultant/
